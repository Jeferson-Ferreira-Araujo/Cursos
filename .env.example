# Supabase project (Settings > API in the Supabase dashboard).
# EXPO_PUBLIC_* variables are bundled into the client app - only put the
# publishable/anon key here. NEVER put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
