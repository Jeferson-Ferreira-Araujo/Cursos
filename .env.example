# Supabase project (Settings > API in the Supabase dashboard).
# EXPO_PUBLIC_* variables are bundled into the client app - only put the
# publishable/anon key here. NEVER put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Savia Studio (V2) does NOT need any client-side env var. Its AI calls
# (transcription, text suggestions, cover generation) run inside Supabase
# Edge Functions, which need their own secret configured in the Supabase
# dashboard (Project > Edge Functions > Secrets) -- never in this file:
#   GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get a free key at https://console.groq.com/keys (no credit card required).
# Cover generation uses Pollinations.ai, which needs no key at all.
